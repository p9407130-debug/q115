#include <stdio.h>
void printFirstNegative(int arr[], int n, int k) {
    int queue[100000]; 
    int front = 0, rear = 0;
    for (int i = 0; i < k; i++) {
        if (arr[i] < 0) {
            queue[rear++] = i;
        }
    }
    for (int i = k; i <= n; i++) {
        if (front < rear) {
            printf("%d ", arr[queue[front]]);
        } else {
            printf("0 ");
        }
        while (front < rear && queue[front] <= i - k) {
            front++;
        }
        if (i < n && arr[i] < 0) {
            queue[rear++] = i;
        }
    }
    printf("\n");
}
int main() {
    int n, k;
    scanf("%d %d", &n, &k);
    int arr[n];
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    printFirstNegative(arr, n, k);
    return 0;
}
